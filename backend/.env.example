# Copy this file to backend/.env and fill in real values. Never commit .env.

# Required: Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: comma-separated list of allowed frontend origins for CORS.
# If unset, only http://localhost:5500 and http://127.0.0.1:5500 are allowed.
# CORS_ORIGINS=https://your-frontend.vercel.app

# Optional: override the outputs directory (defaults to ./outputs)
# OUTPUTS_DIR=/tmp/outputs
